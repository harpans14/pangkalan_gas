<!DOCTYPE html>
<html>
<head>
    <title>Daftar Pesanan Masuk</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="d-flex justify-content-between mb-3">
            <h3>Daftar Antrean Pesanan Gas</h3>
            <div>
                <a href="/pangkalan/kelola-produk" class="btn btn-outline-primary btn-sm">Kelola Produk</a>
                <a href="/logout" class="btn btn-outline-danger btn-sm">Logout</a>
            </div>
        </div>

        <% 
            let alertMsg = '';
            let alertType = '';
            if (success === 'acc_berhasil') { alertMsg = 'Pesanan berhasil di-ACC. Stok sudah dikurangi.'; alertType = 'success'; }
            else if (success === 'tolak_berhasil') { alertMsg = 'Pesanan berhasil ditolak.'; alertType = 'success'; }
            else if (error === 'transaksi_tidak_ditemukan') { alertMsg = 'Transaksi tidak ditemukan.'; alertType = 'danger'; }
            else if (error === 'transaksi_sudah_diproses') { alertMsg = 'Pesanan sudah diproses sebelumnya.'; alertType = 'danger'; }
            else if (error === 'produk_tidak_ditemukan') { alertMsg = 'Produk tidak ditemukan di database.'; alertType = 'danger'; }
            else if (error === 'stok_tidak_cukup') { alertMsg = 'Stok tidak mencukupi untuk pesanan ini.'; alertType = 'danger'; }
            else if (error === 'server_error') { alertMsg = 'Terjadi kesalahan server. Silakan coba lagi.'; alertType = 'danger'; }
        %>
        <% if (alertMsg) { %>
            <div class="alert alert-<%= alertType %> alert-dismissible fade show"><%= alertMsg %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <table class="table table-bordered bg-white shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Nama Pembeli</th>
                    <th>Produk</th>
                    <th>Jumlah</th>
                    <th>Stok Tersedia</th>
                    <th>Metode</th>
                    <th>Tanggal Pesan</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% if (listPesanan.length === 0) { %>
                <tr><td colspan="7" class="text-center text-muted">Belum ada pesanan masuk.</td></tr>
                <% } else { %>
                <% listPesanan.forEach(p => { %>
                <tr>
                    <td><%= p.nama %> <br> <small class="text-muted"><%= p.alamat %></small></td>
                    <td><%= p.produk %></td>
                    <td><%= p.jumlah %> Tabung</td>
                    <td><span class="badge <%= p.stok_tersedia >= p.jumlah ? 'bg-success' : 'bg-danger' %>"><%= p.stok_tersedia %></span></td>
                    <td><span class="badge bg-info"><%= p.metode === 'kirim' ? 'Dikirim' : p.metode === 'ambil' ? 'Diambil' : p.metode %></span></td>
                    <td><%= new Date(p.tanggal).toLocaleDateString('id-ID') %></td>
                    <td>
                        <form action="/pangkalan/acc-proses" method="POST" style="display:inline;">
                            <input type="hidden" name="id_transaksi" value="<%= p.id %>">
                            <button type="submit" class="btn btn-success btn-sm">ACC</button>
                        </form>
                        <form action="/pangkalan/tolak-proses" method="POST" style="display:inline;">
                            <input type="hidden" name="id_transaksi" value="<%= p.id %>">
                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Yakin ingin menolak pesanan ini?')">Tolak</button>
                        </form>
                    </td>
                </tr>
                <% }) } %>
            </tbody>
        </table>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
