<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola Banner - Pangkalan Gas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="sidebar-gas" id="sidebar">
    <div class="sidebar-header">
        <h5><i class="bi bi-fire me-2"></i>Pangkalan Gas</h5>
        <small>Panel Admin</small>
    </div>
    <div class="sidebar-menu">
        <div class="nav-item">
            <a class="nav-link" href="/pangkalan/pesan-masuk">
                <i class="bi bi-inbox"></i> Pesanan Masuk
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="/pangkalan/kelola-produk">
                <i class="bi bi-box"></i> Kelola Produk
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="/pangkalan/barang-masuk">
                <i class="bi bi-arrow-down-circle"></i> Barang Masuk
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="/pangkalan/tabung">
                <i class="bi bi-archive"></i> Manajemen Tabung
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="/pangkalan/laporan">
                <i class="bi bi-file-earmark-bar-graph"></i> Laporan
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="/pangkalan/transaksi-langsung">
                <i class="bi bi-cart-check"></i> Transaksi Langsung
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="/pangkalan/daftar-pelanggan">
                <i class="bi bi-person-plus"></i> Daftar Pelanggan
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link active" href="/pangkalan/carousel">
                <i class="bi bi-images"></i> Kelola Banner
            </a>
        </div>
    </div>
    <div class="sidebar-footer">
        <div class="user-info">
            <div class="user-avatar"><%= username.charAt(0).toUpperCase() %></div>
            <div>
                <div style="font-weight:600;font-size:0.9rem;"><%= username %></div>
                <small class="text-muted">Pangkalan</small>
            </div>
            <a href="/logout" class="ms-auto btn btn-sm btn-gas btn-gas-danger" title="Logout">
                <i class="bi bi-box-arrow-right"></i>
            </a>
        </div>
    </div>
</div>

<div class="main-content page-entrance">
    <div class="topbar">
        <div class="d-flex align-items-center gap-3">
            <button class="sidebar-toggle" id="sidebarToggle">
                <i class="bi bi-list"></i>
            </button>
            <h5 class="mb-0 fw-bold">Kelola Banner Landing Page</h5>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge badge-approved"><i class="bi bi-images"></i> <%= banners.length %> Banner</span>
        </div>
    </div>

    <div class="page-content">
        <%
            let alertMsg = '';
            let alertType = '';
            if (success === 'tambah') { alertMsg = 'Banner baru berhasil ditambahkan!'; alertType = 'success'; }
            else if (success === 'hapus') { alertMsg = 'Banner berhasil dihapus!'; alertType = 'success'; }
            else if (success === 'info_edit') { alertMsg = 'Informasi website berhasil diperbarui!'; alertType = 'success'; }
            else if (error === 'no_file') { alertMsg = 'Harap pilih file gambar banner!'; alertType = 'danger'; }
            else if (error === 'gagal') { alertMsg = 'Gagal memproses banner!'; alertType = 'danger'; }
            else if (error === 'not_found') { alertMsg = 'Banner tidak ditemukan!'; alertType = 'danger'; }
        %>
        <% if (alertMsg) { %>
            <div class="alert alert-gas alert-gas-<%= alertType %> alert-dismissible fade show" role="alert" data-auto-dismiss="5000">
                <i class="bi <%= alertType === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill' %>"></i>
                <%= alertMsg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <div class="row g-4">
            <!-- UPLOAD FORM -->
            <div class="col-lg-4">
                <div class="card-gas reveal">
                    <div class="card-header bg-gas-primary text-white">
                        <i class="bi bi-cloud-upload me-2"></i>Tambah Banner Baru
                    </div>
                    <div class="card-body">
                        <form action="/pangkalan/carousel/upload" method="POST" enctype="multipart/form-data" class="form-gas">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Pilih Gambar Banner</label>
                                <input type="file" name="image" class="form-control" accept=".jpg,.jpeg,.png" required>
                                <small class="text-muted">Rekomendasi rasio landscape. Maks: 5MB (JPG, JPEG, PNG)</small>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Judul Banner <small class="text-muted">(Opsional)</small></label>
                                <input type="text" name="title" class="form-control" placeholder="Contoh: Stok Gas Melimpah">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Deskripsi Banner <small class="text-muted">(Opsional)</small></label>
                                <textarea name="description" class="form-control" rows="3" placeholder="Contoh: Kami melayani pemesanan gas LPG 3kg, 5kg, dan 12kg dengan harga eceran tertinggi resmi."></textarea>
                            </div>
                            <button type="submit" class="btn btn-gas btn-gas-primary w-100">
                                <i class="bi bi-plus-lg"></i> Upload Banner
                            </button>
                        </form>
                    </div>
                </div>

                <!-- WEBSITE SETTINGS FORM -->
                <div class="card-gas reveal mt-4">
                    <div class="card-header bg-gas-primary text-white">
                        <i class="bi bi-gear me-2"></i>Info Website & Kontak
                    </div>
                    <div class="card-body">
                        <form action="/pangkalan/carousel/info" method="POST" class="form-gas">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Deskripsi Ringkas Footer</label>
                                <textarea name="description" class="form-control" rows="3" required><%= websiteInfo.description %></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Alamat Pangkalan</label>
                                <input type="text" name="address" class="form-control" value="<%= websiteInfo.address %>" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Nomor Telepon/HP</label>
                                <input type="text" name="phone" class="form-control" value="<%= websiteInfo.phone %>" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Email</label>
                                <input type="email" name="email" class="form-control" value="<%= websiteInfo.email %>" required>
                            </div>
                            <button type="submit" class="btn btn-gas btn-gas-success w-100">
                                <i class="bi bi-save"></i> Simpan Perubahan
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- BANNER LIST -->
            <div class="col-lg-8">
                <div class="card-gas reveal">
                    <div class="card-header">
                        <i class="bi bi-images me-2"></i>Daftar Banner Saat Ini
                    </div>
                    <div class="card-body">
                        <% if (banners.length === 0) { %>
                            <div class="empty-state py-5">
                                <div class="empty-icon text-muted" style="font-size: 3rem;"><i class="bi bi-images"></i></div>
                                <h5 class="mt-3">Belum Ada Banner</h5>
                                <p class="text-muted">Landing page saat ini menggunakan gambar default. Unggah banner baru untuk menggantinya!</p>
                            </div>
                        <% } else { %>
                            <div class="row g-3">
                                <% banners.forEach(b => { %>
                                    <div class="col-md-6">
                                        <div class="card h-100 border-0 shadow-sm" style="border-radius: var(--radius-lg); overflow: hidden; background: var(--gray-50);">
                                            <div class="position-relative" style="height: 180px; overflow: hidden;">
                                                <img src="<%= b.imageUrl %>" class="w-100 h-100 object-fit-cover" alt="Banner Preview">
                                                <div class="position-absolute top-0 end-0 p-2">
                                                    <form action="/pangkalan/carousel/delete/<%= b.id %>" method="POST" onsubmit="return confirm('Yakin ingin menghapus banner ini?');">
                                                        <button type="submit" class="btn btn-danger btn-sm rounded-circle shadow" style="width: 32px; height: 32px; padding: 0;" title="Hapus Banner">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                            <div class="card-body p-3">
                                                <h6 class="fw-bold mb-1"><%= b.title || 'Tanpa Judul' %></h6>
                                                <p class="text-muted mb-2 small" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.4; height: 2.8em;">
                                                    <%= b.description || 'Tidak ada deskripsi.' %>
                                                </p>
                                                <small class="text-muted-xs" style="font-size: 0.7rem;"><i class="bi bi-calendar3 me-1"></i><%= new Date(b.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></small>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
