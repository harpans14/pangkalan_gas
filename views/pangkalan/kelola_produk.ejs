<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola Produk - Pangkalan Gas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="sidebar-gas" id="sidebar">
    <div class="sidebar-header">
        <h5><i class="bi bi-fuel-pump me-2"></i>Pangkalan Gas</h5>
        <small>Panel Admin</small>
    </div>
    <div class="sidebar-menu">
        <div class="nav-item">
            <a class="nav-link" href="/pangkalan/pesan-masuk">
                <i class="bi bi-inbox"></i> Pesanan Masuk
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link active" href="/pangkalan/kelola-produk">
                <i class="bi bi-box"></i> Kelola Produk
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="/pangkalan/barang-masuk">
                <i class="bi bi-arrow-down-circle"></i> Barang Masuk
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="/pangkalan/laporan">
                <i class="bi bi-file-earmark-bar-graph"></i> Laporan
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="/pangkalan/daftar-pelanggan">
                <i class="bi bi-person-plus"></i> Daftar Pelanggan
            </a>
        </div>
    </div>
    <div class="sidebar-footer">
        <div class="user-info">
            <div class="user-avatar">A</div>
            <div>
                <div style="font-weight:600;font-size:0.9rem;">Admin</div>
                <small class="text-muted">Pangkalan</small>
            </div>
            <a href="/logout" class="ms-auto btn btn-sm btn-gas btn-gas-danger" title="Logout">
                <i class="bi bi-box-arrow-right"></i>
            </a>
        </div>
    </div>
</div>

    <div class="main-content page-entrance">
        <div class="topbar">
        <div class="d-flex align-items-center gap-3">
            <button class="sidebar-toggle" id="sidebarToggle">
                <i class="bi bi-list"></i>
            </button>
            <h5 class="mb-0 fw-bold">Kelola Produk</h5>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge badge-approved"><i class="bi bi-box"></i> <%= produk.length %> Produk</span>
        </div>
    </div>

    <div class="page-content">
        <!-- ADD PRODUCT FORM -->
        <div class="card-gas mb-4 reveal">
            <div class="card-header bg-gas-primary text-white">
                <i class="bi bi-plus-circle me-2"></i>Tambah Produk Baru
            </div>
            <div class="card-body">
                <form action="/pangkalan/tambah-produk" method="POST" class="row g-3 form-gas">
                    <div class="col-md-5">
                        <input type="text" name="nama" class="form-control" placeholder="Nama Produk (contoh: Gas LPG 3Kg)" required>
                    </div>
                    <div class="col-md-3">
                        <div class="input-group">
                            <span class="input-group-text bg-white">Rp</span>
                            <input type="number" name="harga" class="form-control" placeholder="Harga" required>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <input type="number" name="stok" class="form-control" placeholder="Stok Awal" value="0">
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-gas btn-gas-primary w-100">
                            <i class="bi bi-plus-lg"></i> Tambah
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- PRODUCT TABLE -->
        <div class="card-gas reveal">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-box-seam me-2"></i>Daftar Produk Gas</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table-gas mb-0">
                        <thead>
                            <tr>
                                <th>Nama Produk</th>
                                <th>Harga</th>
                                <th>Stok</th>
                                <th class="text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (produk.length === 0) { %>
                            <tr>
                                <td colspan="4">
                                    <div class="empty-state">
                                        <div class="empty-icon"><i class="bi bi-box"></i></div>
                                        <h5>Belum Ada Produk</h5>
                                        <p>Tambah produk baru menggunakan form di atas.</p>
                                    </div>
                                </td>
                            </tr>
                            <% } else { %>
                            <% produk.forEach(p => { %>
                            <tr>
                                <td class="fw-bold"><%= p.nama %></td>
                                <td>Rp <%= (p.harga || 0).toLocaleString() %></td>
                                <td>
                                    <span class="badge-gas <%= p.stok > 10 ? 'badge-approved' : p.stok > 0 ? 'badge-pending' : 'badge-rejected' %>">
                                        <i class="bi bi-box-seam"></i> <%= p.stok %> tersedia
                                    </span>
                                </td>
                                <td class="text-center">
                                    <form action="/pangkalan/hapus-produk/<%= p.id %>" method="POST" onsubmit="return confirm('Hapus produk <%= p.nama %>?')">
                                        <button type="submit" class="btn btn-gas btn-gas-danger btn-gas-sm">
                                            <i class="bi bi-trash"></i> Hapus
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            <% }) } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
