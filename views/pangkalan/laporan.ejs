<!DOCTYPE html>
<html>
<head>
    <title>Laporan Penjualan Bulanan</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
    <div class="container mt-4">
        <div class="d-flex justify-content-between mb-3">
            <h3>Laporan Penjualan Bulanan</h3>
            <div>
                <a href="/pangkalan/pesan-masuk" class="btn btn-outline-primary btn-sm">Pesanan Masuk</a>
                <a href="/pangkalan/barang-masuk" class="btn btn-outline-success btn-sm">Barang Masuk</a>
                <a href="/pangkalan/kelola-produk" class="btn btn-outline-primary btn-sm">Kelola Produk</a>
                <a href="/logout" class="btn btn-outline-danger btn-sm">Logout</a>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <form method="GET" action="/pangkalan/laporan" class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Bulan</label>
                        <select name="bulan" class="form-select">
                            <% const bulanList = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember']; %>
                            <% bulanList.forEach((b, i) => { %>
                                <option value="<%= i+1 %>" <%= (parseInt(bulan) === i+1) ? 'selected' : '' %>><%= b %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Tahun</label>
                        <select name="tahun" class="form-select">
                            <% for (let thn = tahun; thn >= tahun - 5; thn--) { %>
                                <option value="<%= thn %>" <%= (parseInt(tahun) === thn) ? 'selected' : '' %>><%= thn %></option>
                            <% } %>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">Tampilkan Laporan</button>
                    </div>
                    <div class="col-md-3">
                        <a href="/pangkalan/laporan/pdf?bulan=<%= bulan %>&tahun=<%= tahun %>" class="btn btn-danger w-100">Download PDF</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card shadow-sm text-center border-primary">
                    <div class="card-body">
                        <h6 class="text-muted">Total Transaksi</h6>
                        <h4 class="text-primary"><%= totalTransaksi %></h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm text-center border-success">
                    <div class="card-body">
                        <h6 class="text-muted">Total Tabung Terjual</h6>
                        <h4 class="text-success"><%= totalTabung %></h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm text-center border-warning">
                    <div class="card-body">
                        <h6 class="text-muted">Total Pendapatan</h6>
                        <h4 class="text-warning"><%= formatRupiah(totalPendapatan) %></h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm text-center border-info">
                    <div class="card-body">
                        <h6 class="text-muted">Pending / Ditolak</h6>
                        <h4 class="text-info"><%= pendingCount %> / <%= ditolakCount %></h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">Rekap Penjualan Per Produk</h5>
            </div>
            <div class="card-body">
                <% if (rekapProduk.length === 0) { %>
                    <p class="text-muted">Belum ada transaksi penjualan pada bulan ini.</p>
                <% } else { %>
                    <table class="table table-bordered table-sm">
                        <thead class="table-dark">
                            <tr>
                                <th>No</th>
                                <th>Nama Produk</th>
                                <th>Harga Satuan</th>
                                <th>Jumlah Terjual</th>
                                <th>Total Pendapatan</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% rekapProduk.forEach((p, i) => { %>
                            <tr>
                                <td><%= i + 1 %></td>
                                <td><%= p.nama %></td>
                                <td><%= formatRupiah(p.harga) %></td>
                                <td><%= p.jumlah %> Tabung</td>
                                <td><%= formatRupiah(p.total) %></td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } %>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Detail Transaksi</h5>
            </div>
            <div class="card-body">
                <% if (transaksi.length === 0) { %>
                    <p class="text-muted">Belum ada transaksi penjualan pada bulan ini.</p>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm">
                            <thead class="table-dark">
                                <tr>
                                    <th>No</th>
                                    <th>Tanggal</th>
                                    <th>Pembeli</th>
                                    <th>Produk</th>
                                    <th>Jumlah</th>
                                    <th>Harga</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% transaksi.forEach((t, i) => { %>
                                <tr>
                                    <td><%= i + 1 %></td>
                                    <td><%= formatTanggal(t.createdAt) %></td>
                                    <td><%= t.User ? t.User.username : '-' %></td>
                                    <td><%= t.Produk ? t.Produk.nama : '-' %></td>
                                    <td><%= t.jumlah_beli %></td>
                                    <td><%= t.Produk ? formatRupiah(t.Produk.harga) : '-' %></td>
                                    <td><%= t.Produk ? formatRupiah(t.Produk.harga * t.jumlah_beli) : '-' %></td>
                                    <td>
                                        <% let badge = 'bg-secondary'; %>
                                        <% if (t.status === 'disetujui' || t.status === 'ACC') { badge = 'bg-success'; } %>
                                        <% if (t.status === 'selesai') { badge = 'bg-primary'; } %>
                                        <% if (t.status === 'pending') { badge = 'bg-warning text-dark'; } %>
                                        <% if (t.status === 'ditolak') { badge = 'bg-danger'; } %>
                                        <span class="badge <%= badge %>"><%= t.status %></span>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
