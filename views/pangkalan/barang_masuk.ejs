<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Barang Masuk - Pangkalan Gas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="sidebar-gas" id="sidebar">
    <div class="sidebar-header">
        <h5><i class="bi bi-fuel-pump me-2"></i>Pangkalan Gas</h5>
        <small>Panel Admin</small>
    </div>
    <div class="sidebar-menu">
        <div class="nav-item">
            <a class="nav-link" href="/pangkalan/pesan-masuk">
                <i class="bi bi-inbox"></i> Pesanan Masuk
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="/pangkalan/kelola-produk">
                <i class="bi bi-box"></i> Kelola Produk
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link active" href="/pangkalan/barang-masuk">
                <i class="bi bi-arrow-down-circle"></i> Barang Masuk
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="/pangkalan/laporan">
                <i class="bi bi-file-earmark-bar-graph"></i> Laporan
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="/pangkalan/daftar-pelanggan">
                <i class="bi bi-person-plus"></i> Daftar Pelanggan
            </a>
        </div>
    </div>
    <div class="sidebar-footer">
        <div class="user-info">
            <div class="user-avatar">A</div>
            <div>
                <div style="font-weight:600;font-size:0.9rem;">Admin</div>
                <small class="text-muted">Pangkalan</small>
            </div>
            <a href="/logout" class="ms-auto btn btn-sm btn-gas btn-gas-danger" title="Logout">
                <i class="bi bi-box-arrow-right"></i>
            </a>
        </div>
    </div>
</div>

    <div class="main-content page-entrance">
        <div class="topbar">
        <div class="d-flex align-items-center gap-3">
            <button class="sidebar-toggle" id="sidebarToggle">
                <i class="bi bi-list"></i>
            </button>
            <h5 class="mb-0 fw-bold">Barang Masuk</h5>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/pangkalan/kelola-produk" class="btn btn-gas btn-gas-outline btn-gas-sm">
                <i class="bi bi-box"></i> Kelola Produk
            </a>
        </div>
    </div>

    <div class="page-content">
        <%
            let alertMsg = '';
            let alertType = '';
            if (success === 'tambah_berhasil') { alertMsg = 'Barang masuk berhasil dicatat. Stok sudah diperbarui.'; alertType = 'success'; }
            else if (success === 'edit_berhasil') { alertMsg = 'Data barang masuk berhasil diubah. Stok sudah disesuaikan.'; alertType = 'success'; }
            else if (success === 'hapus_berhasil') { alertMsg = 'Data barang masuk berhasil dihapus. Stok sudah dikurangi.'; alertType = 'success'; }
            else if (error === 'invalid_input') { alertMsg = 'Data tidak valid. Pastikan produk dipilih dan jumlah diisi dengan benar.'; alertType = 'danger'; }
            else if (error === 'produk_tidak_ditemukan') { alertMsg = 'Produk tidak ditemukan.'; alertType = 'danger'; }
            else if (error === 'not_found') { alertMsg = 'Data tidak ditemukan.'; alertType = 'danger'; }
            else if (error === 'server_error') { alertMsg = 'Terjadi kesalahan server. Silakan coba lagi.'; alertType = 'danger'; }
        %>
        <% if (alertMsg) { %>
            <div class="alert alert-gas alert-gas-<%= alertType %> alert-dismissible fade show" role="alert" data-auto-dismiss="5000">
                <i class="bi <%= alertType === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill' %>"></i>
                <%= alertMsg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <!-- ADD BARANG MASUK FORM -->
        <div class="card-gas mb-4 reveal">
            <div class="card-header bg-gas-primary text-white">
                <i class="bi bi-plus-circle me-2"></i>Tambah Barang Masuk
            </div>
            <div class="card-body">
                <form action="/pangkalan/tambah-barang-masuk" method="POST" class="row g-3 form-gas">
                    <div class="col-md-4">
                        <select name="produk_id" class="form-select" required>
                            <option value="">-- Pilih Produk --</option>
                            <% produkList.forEach(p => { %>
                                <option value="<%= p.id %>"><%= p.nama %> (Stok: <%= p.stok %>)</option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="number" name="jumlah" class="form-control" placeholder="Jumlah" min="1" required>
                    </div>
                    <div class="col-md-3">
                        <input type="date" name="tanggal" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>">
                    </div>
                    <div class="col-md-3">
                        <button type="button" class="btn btn-gas btn-gas-accent w-100" data-bs-toggle="collapse" data-bs-target="#keteranganCollapse">
                            <i class="bi bi-plus-circle"></i> Keterangan
                        </button>
                    </div>
                    <div class="col-12 collapse" id="keteranganCollapse">
                        <textarea name="keterangan" class="form-control" placeholder="Keterangan (opsional)" rows="2"></textarea>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-gas btn-gas-success">
                            <i class="bi bi-save"></i> Simpan Barang Masuk
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- BARANG MASUK TABLE -->
        <div class="card-gas reveal">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-arrow-down-circle me-2"></i>Riwayat Barang Masuk</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table-gas mb-0">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>Tanggal</th>
                                <th>Produk</th>
                                <th>Jumlah</th>
                                <th>Keterangan</th>
                                <th>Dicatat Oleh</th>
                                <th class="text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (barangMasuk.length === 0) { %>
                            <tr>
                                <td colspan="7">
                                    <div class="empty-state">
                                        <div class="empty-icon"><i class="bi bi-archive"></i></div>
                                        <h5>Belum Ada Barang Masuk</h5>
                                        <p>Catat barang masuk menggunakan form di atas.</p>
                                    </div>
                                </td>
                            </tr>
                            <% } else { %>
                            <% barangMasuk.forEach((b, i) => { %>
                            <tr>
                                <td><%= i + 1 %></td>
                                <td><%= b.tanggal ? new Date(b.tanggal).toLocaleDateString('id-ID', { day:'numeric', month:'short', year:'numeric' }) : '-' %></td>
                                <td class="fw-bold"><%= b.Produk ? b.Produk.nama : '-' %></td>
                                <td><span class="badge badge-approved"><%= b.jumlah %> Tabung</span></td>
                                <td><%= b.keterangan || '<span class="text-muted">-</span>' %></td>
                                <td><%= b.User ? b.User.username : '-' %></td>
                                <td>
                                    <div class="action-group justify-content-center">
                                        <button type="button" class="btn btn-gas btn-gas-accent btn-gas-sm" data-bs-toggle="modal" data-bs-target="#editModal<%= b.id %>">
                                            <i class="bi bi-pencil"></i> Edit
                                        </button>
                                        <form action="/pangkalan/hapus-barang-masuk/<%= b.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Hapus data barang masuk ini? Stok akan dikurangi <%= b.jumlah %>.')">
                                            <button type="submit" class="btn btn-gas btn-gas-danger btn-gas-sm">
                                                <i class="bi bi-trash"></i> Hapus
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>

                            <!-- EDIT MODAL -->
                            <div class="modal fade modal-gas" id="editModal<%= b.id %>" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form action="/pangkalan/edit-barang-masuk/<%= b.id %>" method="POST">
                                            <div class="modal-header">
                                                <h5 class="modal-title fw-bold"><i class="bi bi-pencil me-2"></i>Edit Barang Masuk</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body form-gas">
                                                <div class="mb-3">
                                                    <label class="form-label">Produk</label>
                                                    <select name="produk_id" class="form-select" required>
                                                        <% produkList.forEach(p => { %>
                                                            <option value="<%= p.id %>" <%= b.produk_id === p.id ? 'selected' : '' %>><%= p.nama %></option>
                                                        <% }) %>
                                                    </select>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Jumlah</label>
                                                    <input type="number" name="jumlah" class="form-control" value="<%= b.jumlah %>" min="1" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Tanggal</label>
                                                    <input type="date" name="tanggal" class="form-control" value="<%= b.tanggal ? new Date(b.tanggal).toISOString().split('T')[0] : '' %>">
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Keterangan</label>
                                                    <textarea name="keterangan" class="form-control" rows="2"><%= b.keterangan || '' %></textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-gas btn-gas-secondary" data-bs-dismiss="modal">Batal</button>
                                                <button type="submit" class="btn btn-gas btn-gas-accent">
                                                    <i class="bi bi-check-lg"></i> Simpan Perubahan
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            <% }) } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
