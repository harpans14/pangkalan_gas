<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Barang Masuk - Pangkalan Gas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="sidebar-gas" id="sidebar">
    <div class="sidebar-header">
        <h5><i class="bi bi-fire me-2"></i>Pangkalan Gas</h5>
        <small>Panel Admin</small>
    </div>
    <div class="sidebar-menu">
        <div class="nav-item">
            <a class="nav-link" href="/pangkalan/pesan-masuk">
                <i class="bi bi-inbox"></i> Pesanan Masuk
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="/pangkalan/riwayat-transaksi">
                <i class="bi bi-clock-history"></i> Riwayat Transaksi
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="/pangkalan/kelola-produk">
                <i class="bi bi-box"></i> Kelola Produk
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link active" href="/pangkalan/barang-masuk">
                <i class="bi bi-arrow-down-circle"></i> Barang Masuk
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="/pangkalan/tabung">
                <i class="bi bi-archive"></i> Manajemen Tabung
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="/pangkalan/laporan">
                <i class="bi bi-file-earmark-bar-graph"></i> Laporan
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="/pangkalan/transaksi-langsung">
                <i class="bi bi-cart-check"></i> Transaksi Langsung
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="/pangkalan/daftar-pelanggan">
                <i class="bi bi-person-plus"></i> Daftar Pelanggan
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="/pangkalan/carousel">
                <i class="bi bi-images"></i> Kelola Banner
            </a>
        </div>
    </div>
    <div class="sidebar-footer">
        <div class="user-info">
            <div class="user-avatar"><%= username.charAt(0).toUpperCase() %></div>
            <div>
                <div style="font-weight:600;font-size:0.9rem;"><%= username %></div>
                <small class="text-muted">Pangkalan</small>
            </div>
            <a href="/logout" class="ms-auto btn btn-sm btn-gas btn-gas-danger" title="Logout">
                <i class="bi bi-box-arrow-right"></i>
            </a>
        </div>
    </div>
</div>

    <div class="main-content page-entrance">
        <div class="topbar">
        <div class="d-flex align-items-center gap-3">
            <button class="sidebar-toggle" id="sidebarToggle">
                <i class="bi bi-list"></i>
            </button>
            <h5 class="mb-0 fw-bold">Barang Masuk</h5>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/pangkalan/kelola-produk" class="btn btn-gas btn-gas-outline btn-gas-sm">
                <i class="bi bi-box"></i> Kelola Produk
            </a>
        </div>
    </div>

    <div class="page-content">
        <%
            let alertMsg = '';
            let alertType = '';
            if (success === 'tambah_berhasil') { alertMsg = 'Barang masuk berhasil dicatat. Stok sudah diperbarui.'; alertType = 'success'; }
            else if (error === 'invalid_input') { alertMsg = 'Data tidak valid. Pastikan produk dipilih dan jumlah diisi dengan benar.'; alertType = 'danger'; }
            else if (error === 'produk_tidak_ditemukan') { alertMsg = 'Produk tidak ditemukan.'; alertType = 'danger'; }
            else if (error === 'stok_kosong_tidak_cukup') { alertMsg = 'Stok tabung kosong tidak mencukupi! Isi ulang tabung kosong terlebih dahulu.'; alertType = 'danger'; }
            else if (error === 'server_error') { alertMsg = 'Terjadi kesalahan server. Silakan coba lagi.'; alertType = 'danger'; }
        %>
        <% if (alertMsg) { %>
            <div class="alert alert-gas alert-gas-<%= alertType %> alert-dismissible fade show" role="alert" data-auto-dismiss="5000">
                <i class="bi <%= alertType === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill' %>"></i>
                <%= alertMsg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <!-- ADD BARANG MASUK FORM -->
        <div class="card-gas mb-4 reveal">
            <div class="card-header bg-gas-primary text-white">
                <i class="bi bi-plus-circle me-2"></i>Tambah Barang Masuk
            </div>
            <div class="card-body">
                <form action="/pangkalan/tambah-barang-masuk" method="POST" class="row g-3 form-gas">
                    <div class="col-md-4">
                        <select name="produk_id" class="form-select" required>
                            <option value="">-- Pilih Produk --</option>
                            <% produkList.forEach(p => { %>
                                <option value="<%= p.id %>"><%= p.nama %> (Stok: <%= p.stok %>)</option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="number" name="jumlah" class="form-control" placeholder="Jumlah" min="1" required>
                    </div>
                    <div class="col-md-3">
                        <input type="date" name="tanggal" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>">
                    </div>
                    <div class="col-md-3">
                        <button type="button" class="btn btn-gas btn-gas-accent w-100" data-bs-toggle="collapse" data-bs-target="#keteranganCollapse">
                            <i class="bi bi-plus-circle"></i> Keterangan
                        </button>
                    </div>
                    <div class="col-12 collapse" id="keteranganCollapse">
                        <textarea name="keterangan" class="form-control" placeholder="Keterangan (opsional)" rows="2"></textarea>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-gas btn-gas-success">
                            <i class="bi bi-save"></i> Simpan Barang Masuk
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- STOK KOSONG INFO -->
        <% if (tabungStokList && tabungStokList.length > 0) { %>
        <div class="card-gas mb-4 reveal">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <div style="width:36px;height:36px;border-radius:8px;background:var(--accent-light);color:var(--accent);display:flex;align-items:center;justify-content:center;font-size:1rem;flex-shrink:0;">
                        <i class="bi bi-box"></i>
                    </div>
                    <span class="fw-bold">Stok Tabung Kosong Tersedia:</span>
                    <% tabungStokList.forEach(s => { %>
                        <span class="badge-gas badge-pending"><%= s.jenis %>: <strong><%= s.jumlah_kosong || 0 %></strong></span>
                    <% }) %>
                    <small class="text-muted">(Jumlah maksimal yang bisa diisi ulang)</small>
                </div>
            </div>
        </div>
        <% } %>

        <!-- BARANG MASUK TABLE -->
        <div class="card-gas reveal">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-arrow-down-circle me-2"></i>Riwayat Barang Masuk</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table-gas mb-0">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>Tanggal</th>
                                <th>Produk</th>
                                <th>Jumlah</th>
                                <th>Keterangan</th>
                                <th>Dicatat Oleh</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (barangMasuk.length === 0) { %>
                            <tr>
                                <td colspan="6">
                                    <div class="empty-state">
                                        <div class="empty-icon"><i class="bi bi-archive"></i></div>
                                        <h5>Belum Ada Barang Masuk</h5>
                                        <p>Catat barang masuk menggunakan form di atas.</p>
                                    </div>
                                </td>
                            </tr>
                            <% } else { %>
                            <% barangMasuk.forEach((b, i) => { %>
                            <tr>
                                <td><%= i + 1 %></td>
                                <td><%= b.tanggal ? new Date(b.tanggal).toLocaleDateString('id-ID', { day:'numeric', month:'short', year:'numeric' }) : '-' %></td>
                                <td class="fw-bold"><%= b.Produk ? b.Produk.nama : '-' %></td>
                                <td><span class="badge badge-approved"><%= b.jumlah %> Tabung</span></td>
                                <td><%= b.keterangan || '<span class="text-muted">-</span>' %></td>
                                <td><%= b.User ? b.User.username : '-' %></td>
                            </tr>
                            <% }) } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
