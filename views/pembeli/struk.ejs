<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Struk Transaksi - Pangkalan Gas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body {
            background: #f5f5f5;
            font-family: 'Courier New', monospace;
        }
        .receipt-wrapper {
            max-width: 400px;
            margin: 30px auto;
        }
        .receipt {
            background: #fff;
            padding: 24px 20px 20px;
            border-radius: 4px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.08);
            position: relative;
        }
        .receipt-header {
            text-align: center;
            border-bottom: 2px dashed #333;
            padding-bottom: 12px;
            margin-bottom: 12px;
        }
        .receipt-header h4 {
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 2px;
        }
        .receipt-header .store-info {
            font-size: 0.75rem;
            color: #555;
            line-height: 1.4;
        }
        .receipt-divider {
            border: none;
            border-top: 1px dashed #999;
            margin: 8px 0;
        }
        .receipt-row {
            display: flex;
            justify-content: space-between;
            font-size: 0.8rem;
            padding: 2px 0;
        }
        .receipt-row.label-right {
            justify-content: flex-end;
            gap: 8px;
        }
        .receipt-title {
            text-align: center;
            font-weight: 700;
            font-size: 0.85rem;
            margin: 8px 0;
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        .receipt-item {
            display: flex;
            justify-content: space-between;
            font-size: 0.8rem;
            padding: 3px 0;
        }
        .receipt-item .qty {
            min-width: 30px;
            text-align: center;
        }
        .receipt-item .price {
            min-width: 100px;
            text-align: right;
        }
        .receipt-total {
            border-top: 2px double #333;
            padding-top: 6px;
            margin-top: 6px;
            font-weight: 700;
            font-size: 0.95rem;
        }
        .receipt-footer {
            text-align: center;
            margin-top: 12px;
            padding-top: 12px;
            border-top: 2px dashed #333;
            font-size: 0.8rem;
            color: #555;
        }
        .receipt-footer .thank-you {
            font-weight: 700;
            font-size: 0.9rem;
            color: #222;
            margin-bottom: 4px;
        }
        .status-badge-receipt {
            display: inline-block;
            padding: 2px 10px;
            border-radius: 3px;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .status-lunas { background: #d4edda; color: #155724; }
        .status-belum { background: #f8d7da; color: #721c24; }
        .status-menunggu { background: #fff3cd; color: #856404; }
        .btn-print-receipt {
            display: block;
            width: 100%;
            padding: 10px;
            background: #2d6a4f;
            color: #fff;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 12px;
            text-align: center;
            text-decoration: none;
        }
        .btn-print-receipt:hover {
            background: #1b4332;
            color: #fff;
        }
        .btn-back-receipt {
            display: block;
            width: 100%;
            padding: 10px;
            background: #6c757d;
            color: #fff;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 8px;
            text-align: center;
            text-decoration: none;
        }
        .btn-back-receipt:hover {
            background: #495057;
            color: #fff;
        }
        @media print {
            body { background: #fff; }
            .receipt-wrapper { margin: 0 auto; max-width: 320px; }
            .receipt { box-shadow: none; border-radius: 0; padding: 16px; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body>
    <div class="receipt-wrapper">
        <div class="receipt">
            <div class="receipt-header">
                <h4>PANGKALAN GAS</h4>
                <div class="store-info">
                    <div><%= locals.websiteInfo ? locals.websiteInfo.address : '-' %></div>
                    <div>Telp: <%= locals.websiteInfo ? locals.websiteInfo.phone : '-' %></div>
                    <div>Email: <%= locals.websiteInfo ? locals.websiteInfo.email : '-' %></div>
                </div>
            </div>

            <div class="receipt-row">
                <span>No. Transaksi</span>
                <strong>#<%= String(transaksi.id).padStart(6, '0') %></strong>
            </div>
            <div class="receipt-row">
                <span>Tanggal</span>
                <strong><%= new Date(transaksi.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></strong>
            </div>
            <div class="receipt-row">
                <span>Pelanggan</span>
                <strong><%= transaksi.User ? transaksi.User.username : '-' %></strong>
            </div>
            <hr class="receipt-divider">

            <div class="receipt-title">Detail Pembelian</div>

            <div style="display:flex;justify-content:space-between;font-size:0.75rem;color:#888;padding:2px 0;border-bottom:1px dotted #ccc;">
                <span style="flex:2;">Produk</span>
                <span style="flex:0 0 40px;text-align:center;">Qty</span>
                <span style="flex:0 0 90px;text-align:right;">Harga</span>
                <span style="flex:0 0 90px;text-align:right;">Subtotal</span>
            </div>

            <div class="receipt-item">
                <span style="flex:2;"><%= transaksi.Produk ? transaksi.Produk.nama : '-' %></span>
                <span class="qty" style="flex:0 0 40px;"><%= transaksi.jumlah_beli %></span>
                <span class="price" style="flex:0 0 90px;">Rp<%= transaksi.Produk ? transaksi.Produk.harga.toLocaleString() : 0 %></span>
                <span class="price" style="flex:0 0 90px;">Rp<%= totalHarga.toLocaleString() %></span>
            </div>

            <hr class="receipt-divider">

            <div class="receipt-row receipt-total">
                <span>TOTAL PEMBAYARAN</span>
                <strong>Rp<%= totalHarga.toLocaleString() %></strong>
            </div>

            <hr class="receipt-divider">

            <div class="receipt-row">
                <span>Metode Pembayaran</span>
                <strong>
                    <% if (transaksi.metode_pembayaran === 'cod') { %>COD / Bayar di Tempat<% } %>
                    <% if (transaksi.metode_pembayaran === 'transfer') { %>Transfer Bank<% } %>
                    <% if (transaksi.metode_pembayaran === 'qris') { %>QRIS<% } %>
                </strong>
            </div>
            <div class="receipt-row">
                <span>Status Pembayaran</span>
                <span class="status-badge-receipt
                    <% if (transaksi.status_pembayaran === 'lunas') { %>status-lunas<% } %>
                    <% if (transaksi.status_pembayaran === 'belum_bayar') { %>status-belum<% } %>
                    <% if (transaksi.status_pembayaran === 'menunggu_verifikasi') { %>status-menunggu<% } %>
                ">
                    <% if (transaksi.status_pembayaran === 'lunas') { %>LUNAS<% } %>
                    <% if (transaksi.status_pembayaran === 'belum_bayar') { %>BELUM BAYAR<% } %>
                    <% if (transaksi.status_pembayaran === 'menunggu_verifikasi') { %>MENUNGGU VERIFIKASI<% } %>
                </span>
            </div>
            <div class="receipt-row">
                <span>Metode Pengiriman</span>
                <strong><%= transaksi.metode === 'kirim' ? 'Dikirim (Delivery)' : 'Ambil di Pangkalan' %></strong>
            </div>
            <div class="receipt-row">
                <span>Status Pesanan</span>
                <strong><%= transaksi.status.charAt(0).toUpperCase() + transaksi.status.slice(1) %></strong>
            </div>

            <div class="receipt-footer">
                <div class="thank-you">Terima Kasih</div>
                <div>Barang yang sudah dibeli tidak dapat ditukar/dikembalikan.</div>
                <div style="margin-top:4px;font-size:0.7rem;">Simpan struk ini sebagai bukti transaksi yang sah.</div>
            </div>
        </div>

        <button class="btn-print-receipt no-print" onclick="window.print()">
            <i class="bi bi-printer"></i> Cetak Struk
        </button>
        <a href="/pembeli/dashboard" class="btn-back-receipt no-print">
            <i class="bi bi-arrow-left"></i> Kembali ke Dashboard
        </a>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>