<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profil - Pangkalan Gas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="sidebar-gas" id="sidebar">
    <div class="sidebar-header">
        <h5><i class="bi bi-fire me-2"></i>Pangkalan Gas</h5>
        <small>Panel Pembeli</small>
    </div>
    <div class="sidebar-menu">
        <div class="nav-item">
            <a class="nav-link" href="/pembeli/dashboard?tab=tab-dashboard">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="/pembeli/dashboard?tab=tab-pesan">
                <i class="bi bi-cart-plus"></i> Pesan Gas
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="/pembeli/dashboard?tab=tab-riwayat">
                <i class="bi bi-clock-history"></i> Riwayat
            </a>
        </div>
    </div>
    <div class="sidebar-footer">
        <div class="dropdown">
            <div class="user-info dropdown-toggle no-caret" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer;">
                <div class="user-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
                <div class="d-none d-md-block text-start">
                    <div style="font-weight:600;font-size:0.85rem;"><%= user.username %></div>
                    <small class="text-muted" style="font-size:0.7rem;"><%= user.sub_role === 'rumahtangga' ? 'Rumah Tangga' : 'Usaha Mikro' %></small>
                </div>
            </div>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" style="border-radius: 12px; min-width: 180px;">
                <li class="px-3 py-2 border-bottom d-md-none">
                    <div style="font-weight:600;font-size:0.85rem;color:var(--gray-800);"><%= user.username %></div>
                    <small class="text-muted" style="font-size:0.7rem;"><%= user.sub_role === 'rumahtangga' ? 'Rumah Tangga' : 'Usaha Mikro' %></small>
                </li>
                <li>
                    <a class="dropdown-item py-2 active" href="/pembeli/edit-profil">
                        <i class="bi bi-person-gear me-2"></i>Edit Profil
                    </a>
                </li>
                <li><hr class="dropdown-divider my-1"></li>
                <li>
                    <a class="dropdown-item py-2 text-danger" href="/logout">
                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

<div class="main-content page-entrance">
    <div class="page-content">
        <!-- Visible Header Section -->
        <div class="d-flex align-items-center justify-content-between mb-4 reveal">
            <div class="d-flex align-items-center gap-3">
                <a href="/pembeli/dashboard" class="btn-gas-back" title="Kembali ke Dashboard">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div>
                    <h4 class="mb-0 fw-bold text-gray-900">Edit Profil</h4>
                    <p class="text-muted small mb-0">Ubah detail profil Anda</p>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge badge-approved"><i class="bi bi-person"></i> <%= user.username %></span>
            </div>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <% if (locals.success) { %>
                    <div class="alert alert-gas alert-gas-success alert-dismissible fade show" role="alert" data-auto-dismiss="5000">
                        <i class="bi bi-check-circle-fill"></i>
                        Profil berhasil diperbarui!
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>
                <% if (locals.error) { %>
                    <div class="alert alert-gas alert-gas-danger alert-dismissible fade show" role="alert" data-auto-dismiss="6000">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <div class="card-gas reveal">
                    <div class="card-header bg-gas-primary text-white">
                        <i class="bi bi-person-gear me-2"></i>Edit Profil
                    </div>
                    <div class="card-body">
                        <form action="/pembeli/edit-profil" method="POST" class="form-gas">
                            <div class="mb-3">
                                <label class="form-label">Nama Lengkap</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bi bi-person text-gas-primary"></i></span>
                                    <input type="text" name="username" class="form-control" value="<%= user.username %>" required>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Password <small class="text-muted">(kosongkan jika tidak diganti)</small></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bi bi-lock text-gas-primary"></i></span>
                                    <input type="password" name="password" class="form-control" placeholder="Biarkan kosong jika tidak ingin ganti password">
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">No KTP</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bi bi-credit-card text-gas-primary"></i></span>
                                    <input type="text" class="form-control" value="<%= user.no_ktp %>" disabled>
                                </div>
                                <small class="text-muted">No KTP tidak dapat diubah</small>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Jenis Pelanggan</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bi bi-tag text-gas-primary"></i></span>
                                    <input type="text" class="form-control" value="<%= user.sub_role === 'rumahtangga' ? 'Rumah Tangga' : 'Usaha Mikro' %>" disabled>
                                </div>
                                <small class="text-muted">Jenis pelanggan tidak dapat diubah</small>
                            </div>
                            <div class="mb-4">
                                <label class="form-label">Alamat Lengkap</label>
                                <textarea name="alamat" class="form-control" rows="3" required><%= user.alamat || '' %></textarea>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-gas btn-gas-primary">
                                    <i class="bi bi-check-lg"></i> Simpan Perubahan
                                </button>
                                <a href="/pembeli/dashboard" class="btn btn-gas btn-gas-cancel">
                                    <i class="bi bi-arrow-left"></i> Kembali
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>