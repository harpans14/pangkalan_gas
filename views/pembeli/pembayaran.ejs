<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pembayaran - Pangkalan Gas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="sidebar-gas" id="sidebar">
    <div class="sidebar-header">
        <h5><i class="bi bi-fuel-pump me-2"></i>Pangkalan Gas</h5>
        <small>Panel Pembeli</small>
    </div>
    <div class="sidebar-menu">
        <div class="nav-item">
            <a class="nav-link" href="/pembeli/dashboard">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="/pembeli/edit-profil">
                <i class="bi bi-person-gear"></i> Edit Profil
            </a>
        </div>
    </div>
    <div class="sidebar-footer">
        <div class="user-info">
            <div class="user-avatar"><%= session.username ? session.username.charAt(0).toUpperCase() : 'U' %></div>
            <div>
                <div style="font-weight:600;font-size:0.9rem;"><%= session.username || 'User' %></div>
                <small class="text-muted">Pembeli</small>
            </div>
            <a href="/logout" class="ms-auto btn btn-sm btn-gas btn-gas-danger" title="Logout">
                <i class="bi bi-box-arrow-right"></i>
            </a>
        </div>
    </div>
</div>

<div class="main-content page-entrance">
    <div class="topbar">
        <div class="d-flex align-items-center gap-3">
            <button class="sidebar-toggle" id="sidebarToggle">
                <i class="bi bi-list"></i>
            </button>
            <h5 class="mb-0 fw-bold">Pembayaran</h5>
        </div>
        <div></div>
    </div>

    <div class="page-content">
        <% if (error === 'no_file') { %>
            <div class="alert alert-gas alert-gas-danger alert-dismissible fade show" role="alert" data-auto-dismiss="5000">
                <i class="bi bi-exclamation-triangle-fill"></i> Silakan pilih file bukti pembayaran terlebih dahulu.
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
        <% if (error === 'sudah_dibayar') { %>
            <div class="alert alert-gas alert-gas-danger alert-dismissible fade show" role="alert" data-auto-dismiss="5000">
                <i class="bi bi-exclamation-triangle-fill"></i> Pembayaran untuk pesanan ini sudah diproses.
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <div class="row g-4 justify-content-center">
            <div class="col-lg-6">
                <div class="card-gas">
                    <div class="card-header">
                        <i class="bi bi-receipt me-2"></i>Detail Pesanan
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Produk</span>
                            <strong><%= transaksi.Produk ? transaksi.Produk.nama : '-' %></strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Jumlah</span>
                            <strong><%= transaksi.jumlah_beli %> Tabung</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Harga Satuan</span>
                            <strong>Rp<%= transaksi.Produk ? transaksi.Produk.harga.toLocaleString() : 0 %></strong>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Total Harga</span>
                            <strong class="text-gas-primary" style="font-size:1.2rem;">Rp<%= totalHarga.toLocaleString() %></strong>
                        </div>
                    </div>
                </div>

                <% if (transaksi.metode_pembayaran === 'qris') { %>
                <div class="card-gas mt-3">
                    <div class="card-header">
                        <i class="bi bi-qr-code me-2"></i>Pembayaran QRIS
                    </div>
                    <div class="card-body text-center">
                        <p class="text-muted mb-3">Scan QR Code berikut untuk melakukan pembayaran:</p>
                        <div class="mb-3 p-3 d-inline-block" style="border:2px dashed var(--primary-light);border-radius:12px;">
                            <img src="/uploads/qris.png" alt="QRIS" style="max-width:200px;width:100%;"
                                 onerror="this.style.display='none';document.getElementById('qrisPlaceholder').style.display='flex';">
                            <div id="qrisPlaceholder" style="display:none;width:200px;height:200px;background:var(--bg-light);border-radius:8px;align-items:center;justify-content:center;flex-direction:column;gap:8px;">
                                <i class="bi bi-qr-code" style="font-size:3rem;color:var(--primary);"></i>
                                <small class="text-muted">QRIS</small>
                            </div>
                        </div>
                        <div class="alert alert-info text-start">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Instruksi:</strong>
                            <ol class="mb-0 mt-2">
                                <li>Buka aplikasi pembayaran (GoPay, OVO, DANA, Mobile Banking, dll).</li>
                                <li>Pilih menu <strong>Scan QR</strong> atau <strong>QRIS</strong>.</li>
                                <li>Scan QR Code di atas.</li>
                                <li>Pastikan total pembayaran sesuai: <strong>Rp<%= totalHarga.toLocaleString() %></strong></li>
                                <li>Lakukan pembayaran dan simpan bukti screenshot.</li>
                                <li>Upload bukti pembayaran di bawah.</li>
                            </ol>
                        </div>
                    </div>
                </div>
                <% } %>

                <% if (transaksi.metode_pembayaran === 'transfer') { %>
                <div class="card-gas mt-3">
                    <div class="card-header">
                        <i class="bi bi-bank me-2"></i>Pembayaran Transfer Bank
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Instruksi Transfer:</strong>
                            <hr class="my-2">
                            <div class="mb-2">
                                <strong>Bank BCA</strong><br>
                                No. Rekening: <strong class="text-gas-primary">1234567890</strong><br>
                                Atas Nama: <strong>Pangkalan Gas</strong>
                            </div>
                            <div class="mb-2">
                                <strong>Bank Mandiri</strong><br>
                                No. Rekening: <strong class="text-gas-primary">9876543210</strong><br>
                                Atas Nama: <strong>Pangkalan Gas</strong>
                            </div>
                            <hr class="my-2">
                            <ol class="mb-0">
                                <li>Transfer sejumlah <strong>Rp<%= totalHarga.toLocaleString() %></strong> ke salah satu rekening di atas.</li>
                                <li>Simpan bukti transfer (screenshot atau foto).</li>
                                <li>Upload bukti transfer di bawah.</li>
                            </ol>
                        </div>
                    </div>
                </div>
                <% } %>

                <div class="card-gas mt-3">
                    <div class="card-header">
                        <i class="bi bi-upload me-2"></i>Upload Bukti Pembayaran
                    </div>
                    <div class="card-body">
                        <form action="/pembeli/upload-bukti/<%= transaksi.id %>" method="POST" enctype="multipart/form-data" class="form-gas">
                            <div class="mb-3">
                                <label class="form-label">Pilih File Bukti Pembayaran</label>
                                <input type="file" name="bukti_pembayaran" class="form-control" accept=".jpg,.jpeg,.png" required>
                                <small class="text-muted">Format: JPG, JPEG, PNG. Maks: 2MB</small>
                            </div>
                            <button type="submit" class="btn btn-gas btn-gas-success btn-gas-lg w-100">
                                <i class="bi bi-cloud-upload"></i> Upload Bukti Pembayaran
                            </button>
                        </form>
                    </div>
                </div>

                <div class="text-center mt-3">
                    <a href="/pembeli/dashboard" class="btn btn-gas btn-gas-secondary">
                        <i class="bi bi-arrow-left"></i> Kembali ke Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>