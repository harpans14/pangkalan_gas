<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Pangkalan Gas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page page-entrance">

<div class="auth-card">
    <div class="auth-header">
        <div style="font-size:2.5rem;margin-bottom:0.5rem;"><i class="bi bi-fire"></i></div>
        <h4>Selamat Datang</h4>
        <p>Silakan login untuk melanjutkan</p>
    </div>
    <div class="auth-body">
        <% if (locals.error) { %>
            <% var isSuccess = error.includes('berhasil'); %>
            <div class="alert alert-gas alert-gas-<%= isSuccess ? 'success' : 'danger' %> alert-dismissible fade show" role="alert" data-auto-dismiss="6000">
                <i class="bi <%= isSuccess ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill' %>"></i>
                <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <form action="/login" method="POST" class="form-gas needs-validation" novalidate>
            <div class="mb-3">
                <label class="form-label">Username</label>
                <div class="input-group has-validation">
                    <span class="input-group-text bg-white"><i class="bi bi-person text-gas-primary"></i></span>
                    <input type="text" name="username" class="form-control" placeholder="Masukkan username" required>
                    <div class="invalid-feedback">Username belum diisi, harap isi</div>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <div class="input-group has-validation">
                    <span class="input-group-text bg-white"><i class="bi bi-lock text-gas-primary"></i></span>
                    <input type="password" name="password" class="form-control" placeholder="Masukkan password" required>
                    <div class="invalid-feedback">Password belum diisi, harap isi</div>
                </div>
            </div>

            <button type="submit" class="btn btn-gas btn-gas-primary w-100 btn-gas-lg">
                <i class="bi bi-box-arrow-in-right"></i> Login
            </button>
        </form>

        <div class="text-center mt-4">
            <p class="text-muted mb-1" style="font-size:0.9rem;">Belum punya akun?</p>
            <a href="/daftar" class="fw-bold text-gas-primary text-decoration-none">
                <i class="bi bi-person-plus"></i> Daftar sebagai Pembeli
            </a>
        </div>
        <div class="text-center mt-2">
            <a href="/" class="text-muted text-decoration-none small">
                <i class="bi bi-arrow-left"></i> Kembali ke Beranda
            </a>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
<script>
(function() {
    'use strict';
    var forms = document.querySelectorAll('.needs-validation');
    Array.prototype.slice.call(forms).forEach(function(form) {
        form.addEventListener('submit', function(event) {
            if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
            }
            form.classList.add('was-validated');
        }, false);
    });
})();
</script>
</body>
</html>
